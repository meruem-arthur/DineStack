# Copy this file to .env and fill in real values.
# Never commit .env — it's already covered by .gitignore.

# ── Database (Neon) ──────────────────────────────────────────
# Neon dashboard → your project → "Connect" → copy the connection string
# (use the pooled connection string). Looks like:
# postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ── Staff sessions ───────────────────────────────────────────
# Any long random string — used to sign staff/admin login cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# ── Cloudinary (shared across all restaurants) ──────────────
# Cloudinary dashboard → Settings → Upload → add an unsigned upload preset
# scoped to what you want to allow (image only, size cap, folder).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── Paystack ─────────────────────────────────────────────────
# IMPORTANT: there is NO global PAYSTACK_PUBLIC_KEY/PAYSTACK_SECRET_KEY
# env var anymore. Every restaurant has its OWN Paystack account,
# entered through Super Admin → Restaurants → (restaurant) → Payment.
# Nothing Paystack-related belongs in this file.
#
# For each restaurant, set its Paystack webhook URL (in that
# restaurant's own Paystack dashboard → Settings → API Keys & Webhooks)
# to the SAME central endpoint:
#   https://YOUR_DEPLOYED_DOMAIN/api/paystack/webhook

# ── Local development tenant ─────────────────────────────────
# Which restaurant `localhost` resolves to when developing (never used
# in production — see src/lib/tenant.ts). Defaults to "focus" if unset.
DEV_TENANT_SLUG=focus

# ── One-time seed accounts (used only by `bun run db:seed`) ──
# Set these, run the seed once, then you can remove them from .env.
# Creates the platform-level Super Admin (restaurantId = null):
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Creates the first restaurant's own Admin account:
STAFF_ADMIN_NAME=Admin
STAFF_ADMIN_EMAIL=
STAFF_ADMIN_PASSWORD=

# ── First restaurant's own contact details (optional, seed-only) ────
FOCUS_PHONE=
FOCUS_WHATSAPP=
FOCUS_ADDRESS=
# Real production domain for the first restaurant, e.g. example.com —
# only needed once you have a real domain to attach; leave blank in dev.
FOCUS_PRODUCTION_DOMAIN=

# ── Optional: seed a second, synthetic restaurant ───────────
# Proves multi-tenancy locally. Never used by any application code path
# — see src/db/seed.ts. Safe to leave unset/false.
SEED_DEMO_RESTAURANT=false
DEMO_ADMIN_NAME=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
